@* Único badge de estado de la app: el color sale de la clase badge-{clave} en app.css y el punto usa currentColor *@
<span class="badge badge-@Key">
    <span class="badge-dot" aria-hidden="true"></span>
    @Label
</span>

@code {
    // Valores tal como llegan de las APIs (Scheduled, NoShow, WhatsApp…) o claves propias de la UI (ok, overdue, open…)
    [Parameter, EditorRequired] public string Status { get; set; } = "";

    private string Normalized => Status.ToLowerInvariant().Replace(" ", "_").Replace("noshow", "no_show");
    // Un estado desconocido se muestra tal cual con el estilo neutro de .badge
    private string Key   => Labels.ContainsKey(Normalized) ? Normalized : "unknown";
    private string Label => Labels.GetValueOrDefault(Normalized, Status);

    private static readonly Dictionary<string, string> Labels = new()
    {
        ["scheduled"] = "Programada",
        ["confirmed"] = "Confirmada",
        ["completed"] = "Completada",
        ["cancelled"] = "Cancelada",
        ["no_show"]   = "No asistió",
        ["pending"]   = "Pendiente",
        ["sent"]      = "Enviada",
        ["failed"]    = "Fallida",
        ["whatsapp"]  = "WhatsApp",
        ["email"]     = "Email",
        ["ok"]        = "Al día",
        ["upcoming"]  = "Próxima",
        ["overdue"]   = "Vencida",
        ["active"]    = "Activo",
        ["inactive"]  = "Inactivo",
        ["open"]      = "Abierta",
        ["closed"]    = "Cerrada"
    };
}
