@* Tarjeta de mascota de OwnerPortal y VetDashboard. Es un botón para que se pueda abrir con el teclado;
   solo lleva elementos en línea porque un botón no admite bloques dentro *@
<button type="button" class="patient-card" @onclick="OnSelect">
    <span class="patient-card-header">
        <span class="patient-avatar" aria-hidden="true">@Patient.SpeciesIcon</span>
        <span>
            <span class="patient-name">@Patient.Name</span>
            <span class="patient-meta">@Patient.Breed · @(string.IsNullOrEmpty(Patient.SpeciesName) ? Patient.Species : Patient.SpeciesName)</span>
        </span>
    </span>
    <span class="patient-details">
        <span class="patient-detail-item">
            <span class="patient-detail-label">Edad</span>
            <span class="patient-detail-value">@Patient.AgeYears a.</span>
        </span>
        <span class="patient-detail-item">
            <span class="patient-detail-label">Sexo</span>
            <span class="patient-detail-value">@SexLabel(Patient.Sex)</span>
        </span>
        <span class="patient-detail-item">
            <span class="patient-detail-label">Peso</span>
            <span class="patient-detail-value">@Patient.WeightKg kg</span>
        </span>
        @if (!string.IsNullOrEmpty(Patient.Color))
        {
            <span class="patient-detail-item">
                <span class="patient-detail-label">Color</span>
                <span class="patient-detail-value">@Patient.Color</span>
            </span>
        }
    </span>
    @if (ShowOwner)
    {
        <span class="patient-owner">Dueño: @Patient.OwnerName</span>
    }
</button>

@code {
    [Parameter, EditorRequired] public PatientResponse Patient { get; set; } = null!;
    [Parameter] public EventCallback OnSelect { get; set; }
    // Veterinario y administrador ven de quién es la mascota; el propietario solo ve las suyas
    [Parameter] public bool ShowOwner { get; set; }

    private static string SexLabel(string sex) => sex.ToLowerInvariant() switch
    {
        "male"   => "Macho",
        "female" => "Hembra",
        _        => sex
    };
}
