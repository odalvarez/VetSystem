@using System.Text
@* Requisitos siempre visibles mientras se escribe. Las reglas replican PasswordPolicy del backend;
   ambas implementaciones se prueban contra tests/password-cases.json para que no diverjan. *@

<div class="pwd-rules-box">
    <span class="pwd-rules-title" aria-hidden="true">@Title</span>
    <ul class="pwd-rules" aria-label="Requisitos de la contraseña">
        @foreach (var rule in Rules)
        {
            var met = rule.IsMet(Password);
            <li class="pwd-rule @(met ? "met" : "")">
                <span class="pwd-rule-mark" aria-hidden="true"><Icon Name="@(met ? "check" : "circle")" Size="14" /></span>
                @rule.Label
                <span class="visually-hidden">@(met ? "(cumplido)" : "(pendiente)")</span>
            </li>
        }
        @if (IsTooLong(Password))
        {
            <li class="pwd-rule exceeded" role="alert">
                <span class="pwd-rule-mark" aria-hidden="true"><Icon Name="x" Size="14" /></span>
                Máximo 72 caracteres (las letras con tilde cuentan doble)
            </li>
        }
    </ul>
</div>

@code {
    [Parameter] public string Password { get; set; } = "";
    [Parameter] public string Title    { get; set; } = "La contraseña debe tener";

    private sealed record Rule(string Label, Func<string, bool> IsMet);

    private static readonly Rule[] Rules =
    [
        new("Mínimo 8 caracteres",            p => p.Length >= 8),
        new("Al menos una mayúscula",         p => p.Any(char.IsUpper)),
        new("Al menos un número",             p => p.Any(char.IsDigit)),
        new("Un carácter especial (!@#$%…)",  p => p.Any(c => !char.IsLetterOrDigit(c)))
    ];

    public static int RuleCount => Rules.Length;

    // El medidor del registro cuenta reglas cumplidas: así nunca marca "alta" una contraseña que el backend rechazaría
    public static int MetCount(string? password)
    {
        password ??= "";
        return IsTooLong(password) ? 0 : Rules.Count(r => r.IsMet(password));
    }

    // BCrypt solo usa los primeros 72 bytes; el backend rechaza lo que los supere
    private const int MaxBytes = 72;

    public static bool IsTooLong(string? password) => Encoding.UTF8.GetByteCount(password ?? "") > MaxBytes;

    public static bool IsValid(string? password)
    {
        password ??= "";
        return !IsTooLong(password) && Rules.All(r => r.IsMet(password));
    }
}
