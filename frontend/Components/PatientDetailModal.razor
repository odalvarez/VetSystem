@* Detalle de la mascota con 4 pestañas: Datos | Bitácoras | Historia clínica | Vacunas.
   Lo abren veterinario y administrador (edición) y el propietario (solo lectura). *@
@inject PatientApiClient          PatientApi
@inject ConsultationLogApiClient  LogApi
@inject VaccinationApiClient      VaccApi
@inject TokenProvider             Token

<ModalShell Title="@Patient.Name" Icon="paw" Size="ModalSize.Large" CloseOnBackdrop="@IsOwner"
            Subtitle="@($"{Patient.SpeciesName} · {Patient.Breed} · {Patient.OwnerName}")" OnClose="OnClose">
    <div class="stack">
        <div class="admin-tabs" role="group" aria-label="Secciones de la mascota">
            <button type="button" class="admin-tab @TabClass("data")" aria-current="@AriaCurrent("data")" @onclick='() => SwitchTab("data")'>
                <Icon Name="clipboard" Size="16" /> Datos
            </button>
            <button type="button" class="admin-tab @TabClass("logs")" aria-current="@AriaCurrent("logs")" @onclick='() => SwitchTab("logs")'>
                <Icon Name="file-text" Size="16" /> Bitácoras @if (_logCount > 0) { <span class="tab-count">@_logCount</span> }
            </button>
            <button type="button" class="admin-tab @TabClass("records")" aria-current="@AriaCurrent("records")" @onclick='() => SwitchTab("records")'>
                <Icon Name="heart-pulse" Size="16" /> Historia clínica @if (_recordCount > 0) { <span class="tab-count">@_recordCount</span> }
            </button>
            <button type="button" class="admin-tab @TabClass("vaccines")" aria-current="@AriaCurrent("vaccines")" @onclick='() => SwitchTab("vaccines")'>
                <Icon Name="syringe" Size="16" /> Vacunas @if (_vaccineCount > 0) { <span class="tab-count">@_vaccineCount</span> }
            </button>
        </div>

        @if (_tab == "data")
        {
            @if (IsOwner)
            {
                <PetSummary Patient="Patient" />
            }
            else
            {
                @if (!string.IsNullOrEmpty(_dataError))
                {
                    <div class="alert alert-danger" role="alert"><Icon Name="alert" /> @_dataError</div>
                }

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="pd-name">Nombre *</label>
                        <input id="pd-name" class="form-control" @bind="_edit.Name" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="pd-breed">Raza *</label>
                        <input id="pd-breed" class="form-control" @bind="_edit.Breed" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="pd-species">Especie</label>
                        @* La especie no se puede cambiar después del registro: el servicio no la acepta en la edición *@
                        <input id="pd-species" class="form-control" value="@Patient.SpeciesName" disabled />
                    </div>
                    <fieldset class="form-group">
                        <legend class="form-label">Sexo</legend>
                        <div class="segmented">
                            <label>
                                <input type="radio" name="pd-sex" checked="@(_edit.Sex == "male")" @onchange='() => SetSex("male")' />
                                <span class="segmented-option">Macho</span>
                            </label>
                            <label>
                                <input type="radio" name="pd-sex" checked="@(_edit.Sex == "female")" @onchange='() => SetSex("female")' />
                                <span class="segmented-option">Hembra</span>
                            </label>
                        </div>
                    </fieldset>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <div class="form-label-row">
                            <label class="form-label" for="pd-birth-date">Fecha de nac. aproximada</label>
                            <span class="form-label-aside">Edad: @AgeFormat.FromBirthDate(_edit.BirthDate)</span>
                        </div>
                        <input id="pd-birth-date" type="date" class="form-control"
                               value="@_edit.BirthDate.ToString("yyyy-MM-dd")"
                               max="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")"
                               @oninput="HandleBirthDate" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="pd-weight">Peso (kg) *</label>
                        <input id="pd-weight" type="number" step="0.01" min="0.01" class="form-control" @bind="_edit.WeightKg" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="pd-color">Color</label>
                        <input id="pd-color" class="form-control" @bind="_edit.Color" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="pd-microchip">Microchip</label>
                        <input id="pd-microchip" class="form-control" @bind="_edit.MicrochipNumber" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_deleteError))
                {
                    <div class="alert alert-danger" role="alert"><Icon Name="alert" /> @_deleteError</div>
                }
                <div class="row-between">
                    @if (IsAdmin && _confirmingDelete)
                    {
                        <div class="row">
                            <span class="text-danger fw-600">¿Eliminar mascota?</span>
                            <button type="button" class="btn btn-danger btn-sm" @onclick="DeletePatient" disabled="@_deleting">
                                @if (_deleting) { <span class="spinner spinner-sm" aria-hidden="true"></span> }
                                Confirmar
                            </button>
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _confirmingDelete = false">Cancelar</button>
                        </div>
                    }
                    else if (IsAdmin)
                    {
                        <button type="button" class="btn btn-danger-ghost btn-sm" @onclick="() => _confirmingDelete = true">
                            <Icon Name="trash" Size="16" /> Eliminar mascota
                        </button>
                    }
                    else
                    {
                        <span></span>
                    }
                    <button type="button" class="btn btn-primary" @onclick="SaveData" disabled="@_saving">
                        @if (_saving) { <span class="spinner spinner-sm" aria-hidden="true"></span> }
                        Guardar cambios
                    </button>
                </div>
            }
        }

        @if (_tab == "logs")
        {
            @if (_logsLoading)
            {
                <LoadingSpinner Message="Cargando bitácoras…" />
            }
            else if (_showLogForm)
            {
                <ConsultationLogForm Log="_editingLog" PatientId="Patient.Id" OnSaved="OnLogSaved" OnCancel="CancelLogForm" />
            }
            else if (_closedLog != null)
            {
                <div class="alert alert-success" role="status"><Icon Name="check-circle" /> Bitácora cerrada correctamente.</div>
                <div class="row-end">
                    <button type="button" class="btn btn-primary" @onclick="GoToRecordsWithReference">
                        Ir a historia clínica <Icon Name="arrow-right" Size="16" />
                    </button>
                </div>
                <ConsultationLogReadOnly Log="_closedLog" />
                <div class="row-end">
                    <button type="button" class="btn btn-ghost" @onclick="() => _closedLog = null">
                        <Icon Name="arrow-left" Size="16" /> Ver lista de bitácoras
                    </button>
                </div>
            }
            else if (_selectedLog != null)
            {
                <div class="row-between">
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _selectedLog = null">
                        <Icon Name="arrow-left" Size="16" /> Ver lista de bitácoras
                    </button>
                    @if (_selectedLog.IsOpen && !IsOwner)
                    {
                        <div class="row">
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => OpenEditLogForm(_selectedLog)">
                                <Icon Name="pencil" Size="16" /> Editar
                            </button>
                            <button type="button" class="btn btn-danger btn-sm" @onclick="() => CloseLogAsync(_selectedLog)" disabled="@_closingLog">
                                @if (_closingLog) { <span class="spinner spinner-sm" aria-hidden="true"></span> }
                                <Icon Name="lock" Size="16" /> Cerrar bitácora
                            </button>
                        </div>
                    }
                </div>
                @if (!string.IsNullOrEmpty(_logError))
                {
                    <div class="alert alert-danger" role="alert"><Icon Name="alert" /> @_logError</div>
                }
                <h3 class="form-section-title">Bitácora — @_selectedLog.OpenedAt.ToLocalTime().ToString("dd/MM/yyyy")</h3>
                <ConsultationLogReadOnly Log="_selectedLog" />
            }
            else
            {
                @if (!IsOwner)
                {
                    <div class="row-end">
                        <button type="button" class="btn btn-primary btn-sm" @onclick="OpenNewLogForm">
                            <Icon Name="plus" Size="16" /> Nueva bitácora
                        </button>
                    </div>
                }

                @if (!_logs.Any())
                {
                    <div class="empty-state">
                        <span class="empty-state-icon"><Icon Name="file-text" Size="28" /></span>
                        <p class="empty-state-title">Sin bitácoras</p>
                        <p class="empty-state-sub">
                            @(IsOwner ? "Esta mascota no tiene bitácoras de consulta aún."
                                      : "Crea la primera bitácora para registrar una consulta.")
                        </p>
                    </div>
                }
                else
                {
                    <div class="entry-list">
                        @foreach (var log in _logs)
                        {
                            <button type="button" class="log-list-item" @onclick="() => SelectLog(log)">
                                <span class="row">
                                    <StatusBadge Status="@(log.IsOpen ? "open" : "closed")" />
                                    <span class="entry-title">@log.ReasonForVisit</span>
                                </span>
                                <span class="entry-meta">@log.OpenedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @log.VeterinarianName</span>
                            </button>
                        }
                    </div>
                }
            }
        }

        @if (_tab == "records")
        {
            @if (_referenceLog != null)
            {
                <div class="reference-log-panel">
                    <div class="row-between">
                        <strong class="text-primary">Bitácora de referencia — @_referenceLog.OpenedAt.ToLocalTime().ToString("dd/MM/yyyy")</strong>
                        <div class="row">
                            <button type="button" class="btn btn-ghost btn-sm" aria-expanded="@(_refCollapsed ? "false" : "true")"
                                    @onclick="() => _refCollapsed = !_refCollapsed">
                                @(_refCollapsed ? "Expandir" : "Colapsar")
                            </button>
                            <button type="button" class="icon-btn" aria-label="Quitar referencia" @onclick="() => _referenceLog = null">
                                <Icon Name="x" Size="16" />
                            </button>
                        </div>
                    </div>
                    @if (!_refCollapsed)
                    {
                        <ConsultationLogReadOnly Log="_referenceLog" Compact="true" />
                    }
                </div>
            }

            @if (!IsOwner && !_showRecordForm)
            {
                <div class="row-end">
                    <button type="button" class="btn btn-primary btn-sm" @onclick="() => _showRecordForm = true">
                        <Icon Name="plus" Size="16" /> Agregar entrada
                    </button>
                </div>
            }

            @if (_showRecordForm)
            {
                <div class="form-card">
                    <h3 class="form-section-title">Nueva entrada en historia clínica</h3>
                    @if (!string.IsNullOrEmpty(_recordError))
                    {
                        <div class="alert alert-danger" role="alert"><Icon Name="alert" /> @_recordError</div>
                    }
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" for="rec-date">Fecha *</label>
                            <input id="rec-date" type="date" class="form-control" value="@_recDateStr"
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   @oninput="e => _recDateStr = e.Value?.ToString() ?? string.Empty" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="rec-next-visit">Próxima visita</label>
                            <input id="rec-next-visit" type="date" class="form-control" value="@_recNextStr"
                                   @oninput="e => _recNextStr = e.Value?.ToString() ?? string.Empty" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="rec-reason">Motivo *</label>
                        <input id="rec-reason" class="form-control" @bind="_rec.Reason" placeholder="Motivo de la consulta" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="rec-diagnosis">Diagnóstico *</label>
                        <input id="rec-diagnosis" class="form-control" @bind="_rec.Diagnosis" placeholder="Diagnóstico" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="rec-treatment">Tratamiento *</label>
                        <textarea id="rec-treatment" class="form-control" rows="3" @bind="_rec.Treatment"
                                  placeholder="Tratamiento indicado…"></textarea>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="rec-notes">Notas</label>
                        <textarea id="rec-notes" class="form-control" rows="2" @bind="_rec.Notes"
                                  placeholder="Observaciones adicionales…"></textarea>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" for="rec-weight">Peso (kg)</label>
                            <input id="rec-weight" type="number" step="0.1" min="0" class="form-control" @bind="_rec.WeightKg" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="rec-temperature">Temperatura (°C)</label>
                            <input id="rec-temperature" type="number" step="0.1" min="35" max="42" class="form-control"
                                   @bind="_rec.TemperatureCelsius" />
                        </div>
                    </div>
                    <div class="row-end">
                        <button type="button" class="btn btn-ghost" @onclick="() => _showRecordForm = false">Cancelar</button>
                        <button type="button" class="btn btn-primary" @onclick="SaveRecord" disabled="@_savingRecord">
                            @if (_savingRecord) { <span class="spinner spinner-sm" aria-hidden="true"></span> }
                            Guardar entrada
                        </button>
                    </div>
                </div>
            }

            @if (_recordsLoading)
            {
                <LoadingSpinner Message="Cargando historia clínica…" />
            }
            else if (!_records.Any())
            {
                <div class="empty-state">
                    <span class="empty-state-icon"><Icon Name="heart-pulse" Size="28" /></span>
                    <p class="empty-state-title">Sin entradas</p>
                    <p class="empty-state-sub">La historia clínica de @Patient.Name está vacía.</p>
                </div>
            }
            else
            {
                <div class="entry-list">
                    @foreach (var r in _records)
                    {
                        <article class="record-entry">
                            <header class="record-entry-header">
                                <span>
                                    <strong>@r.Date.ToLocalTime().ToString("dd/MM/yyyy")</strong>
                                    <span class="entry-meta"> · Dr. @r.VeterinarianName</span>
                                </span>
                                @if (r.NextVisitDate.HasValue)
                                {
                                    <span class="entry-meta">Próxima visita: @r.NextVisitDate.Value.ToString("dd/MM/yyyy")</span>
                                }
                            </header>
                            <div class="record-entry-body">
                                <RecordField Label="Motivo"      Value="@r.Reason" />
                                <RecordField Label="Diagnóstico" Value="@r.Diagnosis" />
                                <RecordField Label="Tratamiento" Value="@r.Treatment" />
                                @if (!string.IsNullOrEmpty(r.Notes))
                                {
                                    <RecordField Label="Notas" Value="@r.Notes" />
                                }
                                @if (r.WeightKg.HasValue || r.TemperatureCelsius.HasValue)
                                {
                                    <div class="row text-sm">
                                        @if (r.WeightKg.HasValue)
                                        {
                                            <span><strong>Peso:</strong> @r.WeightKg kg</span>
                                        }
                                        @if (r.TemperatureCelsius.HasValue)
                                        {
                                            <span><strong>Temp:</strong> @r.TemperatureCelsius °C</span>
                                        }
                                    </div>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        }

        @if (_tab == "vaccines")
        {
            @if (!IsOwner)
            {
                <div class="row-end">
                    <button type="button" class="btn btn-primary btn-sm" @onclick="() => _showVaccineForm = !_showVaccineForm">
                        @if (_showVaccineForm)
                        {
                            <span>Cancelar</span>
                        }
                        else
                        {
                            <Icon Name="plus" Size="16" /><span>Registrar dosis</span>
                        }
                    </button>
                </div>

                @if (_showVaccineForm)
                {
                    <div class="form-card">
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label" for="vac-vaccine">Vacuna</label>
                                <select id="vac-vaccine" class="form-control" @bind="_vaccReq.VaccineDefinitionId">
                                    <option value="@Guid.Empty">— Selecciona —</option>
                                    @foreach (var v in _vaccineDefinitions.Where(d => d.IsActive))
                                    {
                                        <option value="@v.Id">@v.Name (@v.Scheme)</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="vac-administered-at">Fecha de aplicación</label>
                                <input id="vac-administered-at" class="form-control" type="date" value="@_vaccReq.AdministeredAt"
                                       @onchange="e => _vaccReq.AdministeredAt = e.Value?.ToString() ?? string.Empty" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label" for="vac-batch">Lote (opcional)</label>
                                <input id="vac-batch" class="form-control" type="text" placeholder="Número de lote"
                                       value="@_vaccReq.BatchNumber" @onchange="e => _vaccReq.BatchNumber = e.Value?.ToString()" />
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="vac-next-due">Próximo refuerzo (opcional — sobreescribe cálculo)</label>
                                <input id="vac-next-due" class="form-control" type="date" value="@_vaccReq.NextDueDateOverride"
                                       @onchange="e => _vaccReq.NextDueDateOverride = e.Value?.ToString()" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="vac-notes">Notas</label>
                            <textarea id="vac-notes" class="form-control" rows="2"
                                      @onchange="e => _vaccReq.Notes = e.Value?.ToString()">@_vaccReq.Notes</textarea>
                        </div>
                        @if (!string.IsNullOrEmpty(_vaccError))
                        {
                            <div class="alert alert-danger" role="alert"><Icon Name="alert" /> @_vaccError</div>
                        }
                        <div class="row-end">
                            <button type="button" class="btn btn-primary" @onclick="SaveVaccinationAsync" disabled="@_vaccSaving">
                                @(_vaccSaving ? "Guardando…" : "Guardar")
                            </button>
                        </div>
                    </div>
                }
            }

            @if (!_vaccRecords.Any())
            {
                <p class="empty-state-text">No hay vacunas registradas para esta mascota.</p>
            }
            else
            {
                <div class="entry-list">
                    @foreach (var r in _vaccRecords)
                    {
                        <article class="record-entry">
                            <header class="record-entry-header">
                                <span class="row">
                                    <strong>@r.VaccineName</strong>
                                    <span class="entry-meta">Dosis @r.DoseNumber</span>
                                    @if (r.DueStatus is "overdue" or "upcoming" or "ok")
                                    {
                                        <StatusBadge Status="@r.DueStatus" />
                                    }
                                    else
                                    {
                                        <span class="badge">Dosis única</span>
                                    }
                                </span>
                                <span class="entry-meta">
                                    @r.AdministeredAt
                                    @if (!string.IsNullOrEmpty(r.NextDueDate))
                                    {
                                        <span> · Próximo: <strong>@r.NextDueDate</strong></span>
                                    }
                                </span>
                            </header>
                            <div class="record-entry-body">
                                <RecordField Label="Aplicado por" Value="@r.AdministeredByName" />
                                @if (!string.IsNullOrEmpty(r.BatchNumber))
                                {
                                    <RecordField Label="Lote" Value="@r.BatchNumber" />
                                }
                                @if (!string.IsNullOrEmpty(r.Notes))
                                {
                                    <RecordField Label="Notas" Value="@r.Notes" />
                                }
                            </div>
                            @if (IsAdmin)
                            {
                                <div class="row-end">
                                    <button type="button" class="btn btn-danger-ghost btn-sm" @onclick="() => DeleteVaccinationAsync(r.Id)">
                                        Eliminar
                                    </button>
                                </div>
                            }
                        </article>
                    }
                </div>
            }
        }
    </div>
</ModalShell>

@code {
    [Parameter, EditorRequired] public PatientResponse Patient { get; set; } = default!;
    [Parameter, EditorRequired] public EventCallback   OnClose { get; set; }
    [Parameter] public EventCallback   OnPatientSaved   { get; set; }
    [Parameter] public EventCallback   OnPatientDeleted { get; set; }
    // Bitácora de referencia inyectada desde el flow cita → HC
    [Parameter] public ConsultationLogResponse? InitialReferenceLog { get; set; }

    // ── Roles ──────────────────────────────────────────────────
    private bool IsOwner => Token.User?.Role?.Equals("Owner", StringComparison.OrdinalIgnoreCase) == true;
    private bool IsAdmin => Token.User?.Role?.Equals("Admin", StringComparison.OrdinalIgnoreCase) == true;

    // ── Tab activa ──────────────────────────────────────────────
    private string _tab = "data";

    // ── Tab datos ──────────────────────────────────────────────
    private UpdatePatientRequest _edit        = new();
    private bool    _saving      = false;
    private string? _dataError;
    private bool    _deleting         = false;
    private bool    _confirmingDelete = false;
    private string? _deleteError;

    // ── Tab bitácoras ───────────────────────────────────────────
    private List<ConsultationLogResponse>  _logs         = [];
    private bool                           _logsLoading  = false;
    private bool                           _showLogForm  = false;
    private ConsultationLogResponse?       _editingLog;   // null = crear, non-null = editar
    private ConsultationLogResponse?       _selectedLog;  // detalle abierto en la pestaña
    private ConsultationLogResponse?       _closedLog;    // vista post-cierre
    private bool                           _closingLog   = false;
    private string?                        _logError;
    private int                            _logCount;

    // ── Tab historia clínica ────────────────────────────────────
    private List<ClinicalRecordResponse>   _records        = [];
    private bool                           _recordsLoading = false;
    private bool                           _showRecordForm = false;
    private bool                           _savingRecord   = false;
    private string?                        _recordError;
    private int                            _recordCount;
    private CreateClinicalRecordRequest    _rec            = new();
    private string                         _recDateStr     = DateTime.Today.ToString("yyyy-MM-dd");
    private string                         _recNextStr     = "";
    // Panel de referencia (bitácora recién cerrada pasada al tab de HC)
    private ConsultationLogResponse?       _referenceLog;
    private bool                           _refCollapsed   = false;

    // ── Tab vacunas ─────────────────────────────────────────────
    private List<VaccinationRecordResponse>  _vaccRecords        = [];
    private List<VaccineDefinitionResponse>  _vaccineDefinitions = [];
    private bool                             _showVaccineForm    = false;
    private bool                             _vaccSaving         = false;
    private string?                          _vaccError;
    private int                              _vaccineCount;
    private RegisterVaccinationRequest       _vaccReq            = new()
        { AdministeredAt = DateTime.Today.ToString("yyyy-MM-dd") };

    protected override async Task OnInitializedAsync()
    {
        // Llegar desde una bitácora recién cerrada abre directo la historia clínica con esa bitácora de referencia
        _tab          = InitialReferenceLog != null ? "records" : "data";
        _referenceLog = InitialReferenceLog;
        _vaccReq      = new() { AdministeredAt = DateTime.Today.ToString("yyyy-MM-dd") };

        LoadEditForm();
        await Task.WhenAll(LoadLogsAsync(), LoadRecordsAsync(), LoadVaccinationsAsync());
    }

    private void LoadEditForm()
    {
        _edit = new UpdatePatientRequest
        {
            Name            = Patient.Name,
            Breed           = Patient.Breed,
            BirthDate       = Patient.BirthDate,
            Sex             = Patient.Sex,
            WeightKg        = Patient.WeightKg,
            Color           = Patient.Color,
            MicrochipNumber = Patient.MicrochipNumber
        };
    }

    private void SwitchTab(string tab) => _tab = tab;

    private string  TabClass(string tab)    => _tab == tab ? "active" : "";
    private string? AriaCurrent(string tab) => _tab == tab ? "true" : null;

    private void SetSex(string sex) => _edit.Sex = sex;

    // ── Datos ───────────────────────────────────────────────────

    private async Task SaveData()
    {
        _dataError = null;
        if (string.IsNullOrWhiteSpace(_edit.Name) || string.IsNullOrWhiteSpace(_edit.Breed))
        { _dataError = "Nombre y raza son obligatorios."; return; }
        if (_edit.WeightKg <= 0)
        { _dataError = "El peso debe ser mayor que cero."; return; }

        _saving = true;
        try
        {
            await PatientApi.UpdateAsync(Patient.Id, _edit);
            await OnPatientSaved.InvokeAsync();
        }
        catch (Exception ex) { _dataError = ex.Message; }
        finally { _saving = false; }
    }

    private async Task DeletePatient()
    {
        _deleteError = null;
        _deleting    = true;
        try
        {
            await PatientApi.DeleteAsync(Patient.Id);
            _confirmingDelete = false;
            await OnPatientDeleted.InvokeAsync();
        }
        catch (Exception ex) { _deleteError = ex.Message; }
        finally { _deleting = false; }
    }

    private void HandleBirthDate(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var d))
            _edit.BirthDate = d;
    }

    // ── Bitácoras ───────────────────────────────────────────────

    private async Task LoadLogsAsync()
    {
        _logsLoading = true;
        try
        {
            var result = await LogApi.ListAsync(Patient.Id, pageSize: 50);
            _logs      = result.Items.ToList();
            _logCount  = result.TotalCount;
        }
        catch { _logs = []; }
        finally { _logsLoading = false; }
    }


    private void OpenNewLogForm()
    {
        _editingLog  = null;
        _showLogForm = true;
    }

    private void OpenEditLogForm(ConsultationLogResponse log)
    {
        _editingLog  = log;
        _selectedLog = null;
        _showLogForm = true;
    }

    private async Task OnLogSaved()
    {
        _showLogForm = false;
        _editingLog  = null;
        await LoadLogsAsync();
    }

    private void CancelLogForm()
    {
        _showLogForm = false;
        _editingLog  = null;
    }

    private void SelectLog(ConsultationLogResponse log) { _selectedLog = log; _logError = null; }

    private async Task CloseLogAsync(ConsultationLogResponse log)
    {
        _closingLog = true;
        _logError   = null;
        try
        {
            var closed   = await LogApi.CloseAsync(Patient.Id, log.Id);
            _closedLog   = closed;
            _selectedLog = null;
            await LoadLogsAsync();
        }
        catch (Exception ex) { _logError = ex.Message; }
        finally { _closingLog = false; }
    }

    // Lleva al tab de Historia Clínica con el panel de referencia activo
    private void GoToRecordsWithReference()
    {
        _referenceLog = _closedLog;
        _refCollapsed = false;
        _closedLog    = null;
        _tab          = "records";
    }

    // ── Historia clínica ────────────────────────────────────────

    private async Task LoadRecordsAsync()
    {
        _recordsLoading = true;
        try
        {
            var result  = await PatientApi.ListRecordsAsync(Patient.Id, page: 1, pageSize: 50);
            _records     = result?.Items?.ToList() ?? [];
            _recordCount = result?.TotalCount ?? 0;
        }
        catch { _records = []; }
        finally { _recordsLoading = false; }
    }

    private async Task SaveRecord()
    {
        _recordError = null;
        if (string.IsNullOrWhiteSpace(_rec.Reason))
        { _recordError = "El motivo es obligatorio."; return; }
        if (string.IsNullOrWhiteSpace(_rec.Diagnosis))
        { _recordError = "El diagnóstico es obligatorio."; return; }
        if (string.IsNullOrWhiteSpace(_rec.Treatment))
        { _recordError = "El tratamiento es obligatorio."; return; }

        if (DateTime.TryParse(_recDateStr, out var d))  _rec.Date = d;
        if (DateOnly.TryParseExact(_recNextStr, "yyyy-MM-dd", out var nv)) _rec.NextVisitDate = nv;

        _savingRecord = true;
        try
        {
            await PatientApi.AddRecordAsync(Patient.Id, _rec);
            _showRecordForm = false;
            _rec = new();
            _recDateStr = DateTime.Today.ToString("yyyy-MM-dd");
            _recNextStr = "";
            await LoadRecordsAsync();
        }
        catch (Exception ex) { _recordError = ex.Message; }
        finally { _savingRecord = false; }
    }

    // ── Misc ────────────────────────────────────────────────────

    private Task Close() => OnClose.InvokeAsync();

    // ── Vacunas ─────────────────────────────────────────────────

    private async Task LoadVaccinationsAsync()
    {
        _vaccRecords        = await VaccApi.ListByPatientAsync(Patient.Id);
        _vaccineDefinitions = await VaccApi.ListDefinitionsAsync();
        _vaccineCount       = _vaccRecords.Count;
    }

    private async Task SaveVaccinationAsync()
    {
        _vaccError  = null;
        _vaccSaving = true;

        try
        {
            if (_vaccReq.VaccineDefinitionId == Guid.Empty)
            { _vaccError = "Selecciona una vacuna."; return; }

            if (string.IsNullOrEmpty(_vaccReq.AdministeredAt))
            { _vaccError = "La fecha de aplicación es obligatoria."; return; }

            var result = await VaccApi.RegisterAsync(Patient.Id, _vaccReq);
            if (result is null)
            { _vaccError = "No se pudo registrar la vacunación."; return; }

            _showVaccineForm = false;
            _vaccReq         = new() { AdministeredAt = DateTime.Today.ToString("yyyy-MM-dd") };
            await LoadVaccinationsAsync();
        }
        finally { _vaccSaving = false; }
    }

    private async Task DeleteVaccinationAsync(Guid recordId)
    {
        await VaccApi.DeleteAsync(Patient.Id, recordId);
        await LoadVaccinationsAsync();
    }
}
