@* Modal de bitácora asociada a una cita.
   Carga la bitácora existente para la cita, o permite crear una nueva.
   Al cerrar una bitácora abierta, ofrece ir directo a la historia clínica. *@
@inject ConsultationLogApiClient LogApi

<ModalShell Title="Bitácora de consulta" Icon="clipboard" Size="ModalSize.Large"
            Subtitle="@($"{Appointment.PatientName} — {Appointment.ScheduledAt:dd/MM/yyyy HH:mm}")" OnClose="OnClose">
    @if (_loading)
    {
        <LoadingSpinner Message="Cargando bitácora…" />
    }
    else if (_justClosed)
    {
        @* Confirmación post-cierre con opción de ir a la historia clínica *@
        <div class="empty-state">
            <span class="empty-state-icon"><Icon Name="check-circle" Size="30" /></span>
            <p class="empty-state-title">Bitácora cerrada correctamente.</p>
            <p class="empty-state-sub">
                ¿Deseas ir a la historia clínica de <strong>@Appointment.PatientName</strong>
                para registrar el resumen médico oficial?
            </p>
            <div class="row">
                <button type="button" class="btn btn-ghost" @onclick="Close">No por ahora</button>
                <button type="button" class="btn btn-primary" @onclick="GoToHC">Ir a historia clínica</button>
            </div>
        </div>
    }
    else if (_log == null)
    {
        <ConsultationLogForm PatientId="Appointment.PatientId" Log="null" AppointmentId="Appointment.Id"
                             OnSaved="EventCallback.Factory.Create(this, OnLogSaved)"
                             OnCancel="EventCallback.Factory.Create(this, Close)" />
    }
    else if (_log.IsOpen)
    {
        <div class="stack">
            <ConsultationLogForm PatientId="Appointment.PatientId" Log="_log" AppointmentId="Appointment.Id"
                                 OnSaved="EventCallback.Factory.Create(this, OnLogSaved)"
                                 OnCancel="EventCallback.Factory.Create(this, Close)" />
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger" role="alert"><Icon Name="alert" /> @_error</div>
            }
            <div class="row-end">
                <button type="button" class="btn btn-danger" @onclick="CloseLog" disabled="@_closing">
                    @if (_closing) { <span class="spinner spinner-sm" aria-hidden="true"></span> }
                    Cerrar bitácora
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="stack">
            <div class="alert alert-info">Esta bitácora está cerrada y no puede modificarse.</div>
            <ConsultationLogReadOnly Log="_log" />
            <div class="row-end">
                <button type="button" class="btn btn-ghost" @onclick="Close">Cerrar</button>
                <button type="button" class="btn btn-primary" @onclick="GoToHC">Ver historia clínica</button>
            </div>
        </div>
    }
</ModalShell>

@code {
    [Parameter, EditorRequired] public AppointmentResponse Appointment { get; set; } = default!;
    [Parameter, EditorRequired] public EventCallback       OnClose     { get; set; }
    // Invocado cuando el usuario quiere ir a la HC; lleva la bitácora como referencia
    [Parameter] public EventCallback<ConsultationLogResponse> OnGoToHC { get; set; }

    private ConsultationLogResponse? _log;
    private bool    _loading    = true;
    private bool    _closing;
    private bool    _justClosed;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadLogAsync();

    private async Task LoadLogAsync()
    {
        _log     = await LogApi.GetByAppointmentAsync(Appointment.PatientId, Appointment.Id);
        _loading = false;
    }

    private async Task OnLogSaved() => await LoadLogAsync();

    private async Task CloseLog()
    {
        if (_log == null) return;
        _closing = true;
        _error   = null;
        try
        {
            _log        = await LogApi.CloseAsync(Appointment.PatientId, _log.Id);
            _justClosed = true;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _closing = false; }
    }

    private async Task GoToHC()
    {
        var log = _log;
        await OnClose.InvokeAsync();
        if (log != null)
            await OnGoToHC.InvokeAsync(log);
    }

    private Task Close() => OnClose.InvokeAsync();
}
