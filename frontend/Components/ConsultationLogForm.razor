@* Formulario para crear o editar una bitácora de consulta.
   Si Log es null se crea una nueva; si no, se edita la existente. *@
@inject ConsultationLogApiClient LogApi

<div class="stack">
    <h3 class="form-section-title">@(Log == null ? "Nueva bitácora" : "Editar bitácora")</h3>
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert"><Icon Name="alert" /> @_error</div>
    }

        @* ── Motivo (obligatorio) ── *@
        <div class="form-group">
            <label class="form-label" for="log-reason">Motivo de consulta *</label>
            <input id="log-reason" class="form-control @(_submitted && string.IsNullOrWhiteSpace(_req.ReasonForVisit) ? "invalid" : "")"
                   @bind="_req.ReasonForVisit"
                   placeholder="Motivo principal de la consulta" />
            <FieldError Show="@(_submitted && string.IsNullOrWhiteSpace(_req.ReasonForVisit))" Message="Campo obligatorio." />
        </div>

        @* ── Anamnesis ── *@
        <div class="form-group">
            <label class="form-label" for="log-anamnesis">Anamnesis</label>
            <textarea id="log-anamnesis" class="form-control" rows="3" @bind="_req.Anamnesis"
                      placeholder="Historia clínica previa, síntomas referidos por el propietario…"></textarea>
        </div>

        @* ── Exploración física (colapsable) ── *@
        <details class="collapse" open="@_showPhysical">
            <summary>Exploración física</summary>
            <div class="collapse-body">
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" for="log-heart-rate">Frecuencia cardíaca</label>
                            <input id="log-heart-rate" class="form-control" @bind="_req.HeartRate" placeholder="ej. 72 lpm" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="log-respiratory-rate">Frecuencia respiratoria</label>
                            <input id="log-respiratory-rate" class="form-control" @bind="_req.RespiratoryRate" placeholder="ej. 18 rpm" />
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" for="log-body-condition">Condición corporal</label>
                            <input id="log-body-condition" class="form-control" @bind="_req.BodyCondition" placeholder="ej. 3/5" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="log-mucous-membranes">Estado de mucosas</label>
                            <input id="log-mucous-membranes" class="form-control" @bind="_req.MucousMembranes" placeholder="ej. Rosadas, húmedas" />
                        </div>
                    </div>
                    <div class="form-group half">
                        <label class="form-label" for="log-hydration">Hidratación</label>
                        <input id="log-hydration" class="form-control" @bind="_req.Hydration" placeholder="ej. Normal" />
                    </div>
            </div>
        </details>

        @* ── Peso y temperatura ── *@
        <div class="form-row">
            <div class="form-group">
                <label class="form-label" for="log-weight">Peso (kg)</label>
                <input id="log-weight" type="number" step="0.01" min="0" class="form-control" @bind="_req.WeightKg" />
            </div>
            <div class="form-group">
                <label class="form-label" for="log-temperature">Temperatura (°C)</label>
                <input id="log-temperature" type="number" step="0.1" min="35" max="42" class="form-control"
                       @bind="_req.TemperatureCelsius" />
            </div>
        </div>

        @* ── Exámenes ── *@
        <details class="collapse" open="@_showTests">
            <summary>Exámenes</summary>
            <div class="collapse-body">
                    <div class="form-group">
                        <label class="form-label" for="log-exams-requested">Exámenes solicitados</label>
                        <textarea id="log-exams-requested" class="form-control" rows="2" @bind="_req.RequestedTests"
                                  placeholder="Hemograma, bioquímica, radiografías…"></textarea>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="log-exam-results">Resultados de exámenes</label>
                        <textarea id="log-exam-results" class="form-control" rows="2" @bind="_req.TestResults"
                                  placeholder="Resultados obtenidos…"></textarea>
                    </div>
            </div>
        </details>

        @* ── Diagnóstico y pronóstico ── *@
        <div class="form-row">
            <div class="form-group">
                <label class="form-label" for="log-diagnosis">Diagnóstico</label>
                <textarea id="log-diagnosis" class="form-control" rows="2" @bind="_req.Diagnosis"
                          placeholder="Diagnóstico presuntivo o definitivo…"></textarea>
            </div>
            <div class="form-group">
                <label class="form-label" for="log-prognosis">Pronóstico</label>
                <textarea id="log-prognosis" class="form-control" rows="2" @bind="_req.Prognosis"
                          placeholder="Pronóstico del caso…"></textarea>
            </div>
        </div>

        @* ── Planes ── *@
        <details class="collapse" open="@_showPlans">
            <summary>Planes</summary>
            <div class="collapse-body">
                    <div class="form-group">
                        <label class="form-label" for="log-treatment-plan">Plan terapéutico (medicamentos y tratamiento)</label>
                        <textarea id="log-treatment-plan" class="form-control" rows="3" @bind="_req.TherapeuticPlan"
                                  placeholder="Medicamentos, dosis, duración, tratamiento indicado…"></textarea>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="log-diagnostic-plan">Plan diagnóstico</label>
                        <textarea id="log-diagnostic-plan" class="form-control" rows="2" @bind="_req.DiagnosticPlan"
                                  placeholder="Estudios adicionales a realizar…"></textarea>
                    </div>
            </div>
        </details>

        @* ── Recomendaciones y próxima visita ── *@
        <div class="form-group">
            <label class="form-label" for="log-recommendations">Recomendaciones</label>
            <textarea id="log-recommendations" class="form-control" rows="2" @bind="_req.Recommendations"
                      placeholder="Cuidados en casa, dieta, ejercicio…"></textarea>
        </div>
        <div class="form-group half">
            <label class="form-label" for="log-next-visit">Próxima visita</label>
            <input id="log-next-visit" type="date" class="form-control"
                   value="@_nextVisitStr"
                   min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                   @oninput="e => _nextVisitStr = e.Value?.ToString() ?? string.Empty" />
        </div>

        <div class="row-end">
            <button type="button" class="btn btn-ghost" @onclick="OnCancel" disabled="@_saving">Cancelar</button>
            <button type="button" class="btn btn-primary" @onclick="Save" disabled="@_saving">
                @if (_saving) { <span class="spinner spinner-sm" aria-hidden="true"></span> }
                @(Log == null ? "Crear bitácora" : "Guardar cambios")
            </button>
        </div>
</div>

@code {
    [Parameter] public ConsultationLogResponse? Log           { get; set; }  // null = crear
    [Parameter] public Guid                     PatientId     { get; set; }
    [Parameter] public Guid?                    AppointmentId { get; set; }
    [Parameter] public EventCallback            OnSaved       { get; set; }
    [Parameter] public EventCallback            OnCancel      { get; set; }

    private CreateConsultationLogRequest _req = new();
    private bool    _submitted    = false;
    private bool    _saving       = false;
    private string? _error;
    private string  _nextVisitStr = "";
    // Solo decide si la sección arranca abierta (al editar, con datos); después manda el <details> nativo
    private bool _showPhysical;
    private bool _showTests;
    private bool _showPlans;

    protected override void OnParametersSet()
    {
        if (Log != null)
        {
            // Precarga los campos al editar
            _req = new CreateConsultationLogRequest
            {
                ReasonForVisit     = Log.ReasonForVisit,
                Anamnesis          = Log.Anamnesis,
                HeartRate          = Log.HeartRate,
                RespiratoryRate    = Log.RespiratoryRate,
                BodyCondition      = Log.BodyCondition,
                MucousMembranes    = Log.MucousMembranes,
                Hydration          = Log.Hydration,
                WeightKg           = Log.WeightKg,
                TemperatureCelsius = Log.TemperatureCelsius,
                RequestedTests     = Log.RequestedTests,
                TestResults        = Log.TestResults,
                Diagnosis          = Log.Diagnosis,
                Prognosis          = Log.Prognosis,
                TherapeuticPlan    = Log.TherapeuticPlan,
                DiagnosticPlan     = Log.DiagnosticPlan,
                Recommendations    = Log.Recommendations,
                NextVisitDate      = Log.NextVisitDate
            };
            _nextVisitStr = Log.NextVisitDate?.ToString("yyyy-MM-dd") ?? "";
            // Abre las secciones que tienen datos
            _showPhysical = Log.HeartRate != null || Log.RespiratoryRate != null
                         || Log.BodyCondition != null || Log.MucousMembranes != null
                         || Log.Hydration != null;
            _showTests    = Log.RequestedTests != null || Log.TestResults != null;
            _showPlans    = Log.TherapeuticPlan != null || Log.DiagnosticPlan != null;
        }
        else
        {
            _req          = new();
            _nextVisitStr = "";
            _showPhysical = false;
            _showTests    = false;
            _showPlans    = false;
        }
        _submitted = false;
        _error     = null;
    }

    private async Task Save()
    {
        _submitted = true;
        if (string.IsNullOrWhiteSpace(_req.ReasonForVisit)) return;

        if (DateOnly.TryParseExact(_nextVisitStr, "yyyy-MM-dd", out var nv))
            _req.NextVisitDate = nv;
        else
            _req.NextVisitDate = null;

        _saving = true;
        _error  = null;
        try
        {
            if (Log == null)
            {
                _req.AppointmentId = AppointmentId;
                await LogApi.CreateAsync(PatientId, _req);
            }
            else
                await LogApi.UpdateAsync(PatientId, Log.Id, _req);

            await OnSaved.InvokeAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }
}
