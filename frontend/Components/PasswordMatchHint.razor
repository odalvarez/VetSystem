@* Avisa mientras la confirmación no coincide; desaparece al coincidir, igual que los requisitos de PasswordStrength *@
@if (!string.IsNullOrEmpty(Confirm) && Password != Confirm)
{
    <p class="pwd-match bad" role="status">Las contraseñas no coinciden</p>
}

@code {
    [Parameter] public string Password { get; set; } = "";
    [Parameter] public string Confirm  { get; set; } = "";
}
