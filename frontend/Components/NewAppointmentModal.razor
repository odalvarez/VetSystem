@* appointments-service no consulta a los otros servicios, por eso la cita viaja con los datos de mascota y dueño *@
@inject PatientApiClient     PatientApi
@inject AppointmentApiClient AppointmentApi
@inject AuthApiClient        AuthApi
@inject TokenProvider        Token
@implements IDisposable

<ModalShell Title="Solicitar cita" Icon="calendar" OnClose="OnClose">
    <ChildContent>
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger" role="alert"><Icon Name="alert" /> @_error</div>
        }

        <div class="form-group">
            <label class="form-label" for="na-patient">Mascota *</label>
            <div class="suggest-wrap">
                <input id="na-patient" class="form-control @Invalid(_selectedPatient is null)" autocomplete="off"
                       role="combobox" aria-autocomplete="list" aria-controls="na-patient-list"
                       aria-expanded="@(_showSuggestions ? "true" : "false")"
                       placeholder="Buscar por nombre, raza, dueño o teléfono…"
                       value="@_patientSearch" @oninput="OnPatientSearchInput"
                       @onfocus="() => _showSuggestions = true" @onblur="HideSuggestions" />
                @if (_showSuggestions && !string.IsNullOrWhiteSpace(_patientSearch))
                {
                    <div id="na-patient-list" class="suggest-list popover" role="listbox">
                        @if (_searching)
                        {
                            <div class="suggest-empty">Buscando…</div>
                        }
                        else if (_patientResults.Count == 0)
                        {
                            <div class="suggest-empty">Sin resultados para "@_patientSearch"</div>
                        }
                        else
                        {
                            @foreach (var p in _patientResults)
                            {
                                <button type="button" class="suggest-item" role="option" @onmousedown="() => SelectPatient(p)">
                                    <span class="suggest-item-title">@p.SpeciesIcon @p.Name <span class="suggest-item-sub">· @p.Breed</span></span>
                                    <span class="suggest-item-sub">@p.OwnerName@(string.IsNullOrEmpty(p.OwnerPhone) ? "" : $" · {p.OwnerPhone}")</span>
                                </button>
                            }
                        }
                    </div>
                }
            </div>
            @if (_submitted && _selectedPatient is null)
            {
                <div class="validation-message">Selecciona una mascota.</div>
            }
        </div>

        <div class="form-group">
            <label class="form-label" for="na-vet">Veterinario *</label>
            @if (_vets is null)
            {
                <LoadingSpinner Message="Cargando veterinarios…" />
            }
            else
            {
                <select id="na-vet" class="form-control @Invalid(_selectedVetId == Guid.Empty)" @onchange="OnVetSelected">
                    <option value="">— Selecciona —</option>
                    @foreach (var v in _vets)
                    {
                        <option value="@v.Id">@v.FullName</option>
                    }
                </select>
                @if (_submitted && _selectedVetId == Guid.Empty)
                {
                    <div class="validation-message">Selecciona un veterinario.</div>
                }
            }
        </div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label" for="na-date">Fecha *</label>
                <input id="na-date" type="date" class="form-control @Invalid(_date == default)"
                       value="@(_date == default ? "" : _date.ToString("yyyy-MM-dd"))"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")" @onchange="OnDateChanged" />
            </div>
            <div class="form-group">
                <label class="form-label" for="na-duration">Duración</label>
                <select id="na-duration" class="form-control" value="@_durationMinutes" @onchange="OnDurationChanged">
                    <option value="20">20 min — Consulta rápida</option>
                    <option value="40">40 min — Consulta estándar</option>
                    <option value="60">60 min — Consulta extendida</option>
                    <option value="90">90 min — Procedimiento</option>
                </select>
            </div>
        </div>

        @if (_selectedVetId != Guid.Empty && _date != default)
        {
            <fieldset class="form-group">
                <legend class="form-label">Hora disponible *</legend>
                @if (_loadingSlots)
                {
                    <LoadingSpinner Message="Consultando disponibilidad…" />
                }
                else if (_slotsError is not null)
                {
                    <div class="alert alert-danger" role="alert"><Icon Name="alert" /> @_slotsError</div>
                }
                else if (_availableSlots.Count == 0)
                {
                    <div class="alert alert-info">Este veterinario no tiene disponibilidad para la fecha y duración seleccionadas.</div>
                }
                else
                {
                    <div class="slot-grid">
                        @foreach (var slot in _availableSlots)
                        {
                            var start = slot.Start;
                            <label>
                                <input type="radio" name="na-slot" checked="@(_selectedSlot == start)"
                                       @onchange="() => SelectSlot(start)" />
                                <span class="slot">@start.ToString("HH:mm")</span>
                            </label>
                        }
                    </div>
                    @if (_submitted && _selectedSlot is null)
                    {
                        <div class="validation-message">Selecciona un horario.</div>
                    }
                }
            </fieldset>
        }

        <div class="form-group">
            <label class="form-label" for="na-reason">Motivo de la cita *</label>
            <textarea id="na-reason" class="form-control @Invalid(string.IsNullOrWhiteSpace(_reason))" rows="2"
                      @bind="_reason" placeholder="Describe brevemente el motivo de la consulta…"></textarea>
            @if (_submitted && string.IsNullOrWhiteSpace(_reason))
            {
                <div class="validation-message">El motivo de la cita es obligatorio.</div>
            }
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-ghost" @onclick="OnClose" disabled="@_saving">Cancelar</button>
        <button type="button" class="btn btn-primary" @onclick="Save" disabled="@_saving">
            @if (_saving)
            {
                <span class="spinner spinner-sm" aria-hidden="true"></span>
            }
            Solicitar cita
        </button>
    </Footer>
</ModalShell>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter, EditorRequired] public EventCallback OnClose { get; set; }

    private bool IsOwner => Token.User?.Role?.Equals("Owner", StringComparison.OrdinalIgnoreCase) == true;

    private List<VetSummary>? _vets;

    private string                _patientSearch = "";
    private List<PatientResponse> _patientResults = [];
    private PatientResponse?      _selectedPatient;
    private bool                  _showSuggestions;
    private bool                  _searching;
    private CancellationTokenSource? _searchCts;

    private Guid      _selectedVetId;
    private DateTime  _date;
    private int       _durationMinutes = 40;
    private string    _reason = "";

    private List<TimeSlot> _availableSlots = [];
    private DateTime?      _selectedSlot;
    private bool           _loadingSlots;
    private string?        _slotsError;
    private int            _slotsRequest;

    private bool    _submitted;
    private bool    _saving;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try { _vets = await AuthApi.GetVeterinariansAsync(); }
        catch (Exception ex) { _vets = []; _error = ex.Message; }
    }

    private string Invalid(bool missing) => _submitted && missing ? "invalid" : "";

    // La búsqueda va al servidor: traer todas las mascotas al navegador dejaba fuera las que superaban
    // el límite de página de la API. El retardo evita una petición por cada tecla
    private async Task OnPatientSearchInput(ChangeEventArgs e)
    {
        _patientSearch   = e.Value?.ToString() ?? "";
        _selectedPatient = null;
        _showSuggestions = true;

        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var ct = _searchCts.Token;

        if (string.IsNullOrWhiteSpace(_patientSearch))
        {
            _patientResults = [];
            _searching      = false;
            return;
        }

        _searching = true;
        try
        {
            await Task.Delay(250, ct);
            var page = await PatientApi.ListAsync(page: 1, pageSize: 8, search: _patientSearch.Trim(),
                                                  ownerId: IsOwner ? Token.User?.Id : null);
            if (ct.IsCancellationRequested) return;
            _patientResults = page?.Items?.ToList() ?? [];
            _searching      = false;
        }
        catch (TaskCanceledException) { }
        catch (Exception ex)
        {
            _patientResults = [];
            _searching      = false;
            _error          = ex.Message;
        }
    }

    private void SelectPatient(PatientResponse p)
    {
        _searchCts?.Cancel();
        _selectedPatient = p;
        _patientSearch   = $"{p.Name} ({p.OwnerName})";
        _patientResults  = [];
        _searching       = false;
        _showSuggestions = false;
    }

    // blur llega antes que el mousedown de la sugerencia; la espera deja que SelectPatient corra primero
    private async Task HideSuggestions()
    {
        await Task.Delay(150);
        _showSuggestions = false;
    }

    // Firefox vuelve a disparar change al salir del input de fecha aunque el valor no cambie; sin estas guardas
    // se recargaban los horarios y se perdía la hora que el usuario acababa de elegir
    private async Task OnVetSelected(ChangeEventArgs e)
    {
        var id = Guid.TryParse(e.Value?.ToString(), out var parsed) ? parsed : Guid.Empty;
        if (id == _selectedVetId) return;
        _selectedVetId = id;
        await ReloadSlots();
    }

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        var date = DateTime.TryParse(e.Value?.ToString(), out var parsed) ? parsed : default;
        if (date == _date) return;
        _date = date;
        await ReloadSlots();
    }

    private async Task OnDurationChanged(ChangeEventArgs e)
    {
        var duration = int.TryParse(e.Value?.ToString(), out var parsed) ? parsed : 40;
        if (duration == _durationMinutes) return;
        _durationMinutes = duration;
        await ReloadSlots();
    }

    private async Task ReloadSlots()
    {
        _selectedSlot = null;
        _slotsError   = null;
        if (_selectedVetId == Guid.Empty || _date == default)
        {
            _availableSlots = [];
            return;
        }

        // Si el usuario cambia fecha o veterinario antes de que llegue la respuesta anterior, esa respuesta ya no aplica
        var request = ++_slotsRequest;
        _loadingSlots   = true;
        _availableSlots = [];
        StateHasChanged();

        List<TimeSlot> slots = [];
        string? error = null;
        try
        {
            var avail = await AppointmentApi.GetAvailabilityAsync(_selectedVetId, DateOnly.FromDateTime(_date), _durationMinutes);
            slots = avail?.AvailableSlots?.ToList() ?? [];
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }

        if (request != _slotsRequest) return;
        _availableSlots = slots;
        _slotsError     = error;
        _loadingSlots   = false;
    }

    private void SelectSlot(DateTime start) => _selectedSlot = start;

    private async Task Save()
    {
        _submitted = true;
        _error     = null;

        if (_selectedPatient is null || _selectedVetId == Guid.Empty || _date == default
            || _selectedSlot is null || string.IsNullOrWhiteSpace(_reason))
            return;

        if (_selectedSlot.Value <= DateTime.Now) { _error = "La fecha y hora deben ser futuras."; return; }

        _saving = true;
        try
        {
            var user    = Token.User;
            var patient = _selectedPatient;
            await AppointmentApi.CreateAsync(new CreateAppointmentRequest
            {
                PatientId        = patient.Id,
                PatientName      = patient.Name,
                VeterinarianId   = _selectedVetId,
                VeterinarianName = _vets?.FirstOrDefault(v => v.Id == _selectedVetId)?.FullName ?? "",
                ScheduledAt      = _selectedSlot.Value,
                DurationMinutes  = _durationMinutes,
                Reason           = _reason,
                OwnerId          = IsOwner ? user!.Id       : patient.OwnerId,
                OwnerName        = IsOwner ? user!.FullName : patient.OwnerName,
                OwnerPhone       = IsOwner ? user!.Phone    : patient.OwnerPhone,
                OwnerEmail       = IsOwner ? user!.Email    : await OwnerEmailAsync(patient.OwnerId)
            });
            await OnSaved.InvokeAsync();
            await OnClose.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    // Sin correo la cita igual se crea; solo se pierde la confirmación por email
    private async Task<string?> OwnerEmailAsync(Guid ownerId)
    {
        try
        {
            var owners = await AuthApi.GetOwnersAsync();
            return owners?.FirstOrDefault(o => o.Id == ownerId)?.Email;
        }
        catch (Exception)
        {
            return null;
        }
    }

    public void Dispose()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }
}
