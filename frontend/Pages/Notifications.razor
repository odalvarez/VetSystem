@page "/notifications"
@attribute [Authorize]
@inject NotificationApiClient NotificationApi
@inject AppointmentApiClient  AppointmentApi
@inject TokenProvider         Token
@inject NavigationManager     Nav

<PageTitle>Notificaciones — VetSystem</PageTitle>

<header class="page-header">
    <div>
        <h1 class="page-title">Notificaciones</h1>
        <p class="page-subtitle">Envío y seguimiento de alertas</p>
    </div>
</header>

<div class="page-content">

    <AuthorizeView Roles="Veterinarian,Admin">
        <Authorized>
            <section class="card" aria-labelledby="send-title">
                <div class="card-header">
                    <h2 id="send-title" class="card-title">Enviar notificación manual</h2>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(_sendError))
                    {
                        <div class="alert alert-danger" role="alert"><Icon Name="alert" /> @_sendError</div>
                    }
                    @if (!string.IsNullOrEmpty(_sendSuccess))
                    {
                        <div class="alert alert-success" role="status"><Icon Name="check-circle" /> @_sendSuccess</div>
                    }

                    <div class="form-row">
                        <fieldset class="form-group">
                            <legend class="form-label">Tipo</legend>
                            <div class="segmented">
                                <label>
                                    <input type="radio" name="notif-type" checked="@(_notifType == "whatsapp")" @onchange='() => _notifType = "whatsapp"' />
                                    <span class="segmented-option">WhatsApp</span>
                                </label>
                                <label>
                                    <input type="radio" name="notif-type" checked="@(_notifType == "email")" @onchange='() => _notifType = "email"' />
                                    <span class="segmented-option">Email</span>
                                </label>
                            </div>
                        </fieldset>

                        @if (_notifType == "whatsapp")
                        {
                            <div class="form-group">
                                <label class="form-label" for="notif-whatsapp">Número WhatsApp</label>
                                <PhoneInput Id="notif-whatsapp" @bind-Value="_whatsappTo" />
                            </div>
                        }
                        else
                        {
                            <div class="form-group">
                                <label class="form-label" for="notif-email">Correo destino</label>
                                <input id="notif-email" class="form-control" @bind="_recipient"
                                       placeholder="correo@ejemplo.com" inputmode="email" />
                            </div>
                        }
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="notif-message">Mensaje</label>
                        <textarea id="notif-message" class="form-control" rows="3" @bind="_message"
                                  placeholder="Escribe el mensaje a enviar…"></textarea>
                    </div>

                    @if (_notifType == "email")
                    {
                        <div class="form-group">
                            <label class="form-label" for="notif-subject">Asunto</label>
                            <input id="notif-subject" class="form-control" @bind="_subject" placeholder="Asunto del correo" />
                        </div>
                    }

                    <button type="button" class="btn btn-primary" @onclick="SendNotification" disabled="@_sending">
                        @if (_sending) { <span class="spinner spinner-sm" aria-hidden="true"></span> }
                        <Icon Name="send" Size="16" /> Enviar @(_notifType == "whatsapp" ? "WhatsApp" : "Email")
                    </button>
                </div>
            </section>
        </Authorized>
    </AuthorizeView>

    <section class="card" aria-labelledby="history-title">
        <div class="card-header">
            <h2 id="history-title" class="card-title">Historial</h2>
            <button type="button" class="btn btn-ghost btn-sm" @onclick="LoadHistory">
                <Icon Name="refresh" Size="16" /> Actualizar
            </button>
        </div>

        @if (_loadingHistory)
        {
            <div class="card-body"><LoadingSpinner Message="Cargando historial…" /></div>
        }
        else
        {
            <div class="card-body filters-region">
                <div class="filters-bar">
                    <select aria-label="Filtrar por tipo" class="filter-select" @bind="_filterType">
                        <option value="">Todos los tipos</option>
                        <option value="whatsapp">WhatsApp</option>
                        <option value="email">Email</option>
                    </select>

                    <select aria-label="Filtrar por estado" class="filter-select" @bind="_filterStatus">
                        <option value="">Todos los estados</option>
                        <option value="pending">Pendiente</option>
                        <option value="sent">Enviada</option>
                        <option value="failed">Fallida</option>
                    </select>

                    @* Etiqueta visible: el placeholder no existe en los inputs de fecha del móvil *@
                    <label class="date-filter-label">
                        <span>Desde</span>
                        <input type="date" class="filter-select" @bind="_filterFrom" />
                    </label>

                    <label class="date-filter-label">
                        <span>Hasta</span>
                        <input type="date" class="filter-select" @bind="_filterTo" />
                    </label>

                    @* Búsqueda por destinatario: solo admin y veterinario *@
                    <AuthorizeView Roles="Veterinarian,Admin">
                        <Authorized>
                            <div class="search-input">
                                <span class="search-icon"><Icon Name="search" Size="16" /></span>
                                <input aria-label="Buscar destinatario" class="form-control"
                                       placeholder="Buscar destinatario…"
                                       @bind="_filterRecipient" @bind:event="oninput" />
                            </div>
                        </Authorized>
                    </AuthorizeView>

                    @if (HasActiveFilters)
                    {
                        <button type="button" class="btn btn-ghost btn-sm" @onclick="ClearFilters">
                            <Icon Name="x" Size="16" /> Limpiar
                        </button>
                    }

                    <span class="entry-meta results-count" role="status">
                        @FilteredHistory.Count() resultado@(FilteredHistory.Count() == 1 ? "" : "s")
                        @if (HasActiveFilters && _history?.Count != FilteredHistory.Count())
                        {
                            <span> de @(_history?.Count ?? 0)</span>
                        }
                    </span>
                </div>
            </div>

            @if (!FilteredHistory.Any())
            {
                <div class="card-body">
                    <div class="empty-state">
                        <span class="empty-state-icon"><Icon Name="bell" Size="28" /></span>
                        <p class="empty-state-title">Sin resultados</p>
                        <p class="empty-state-sub">
                            @(HasActiveFilters ? "Ninguna notificación coincide con los filtros aplicados."
                                               : "Aún no hay notificaciones enviadas.")
                        </p>
                    </div>
                </div>
            }
            else
            {
                <div class="table-wrapper">
                    <table class="vet-table">
                        <thead>
                            <tr>
                                <th>Tipo</th>
                                <th>Destinatario</th>
                                <th>Estado</th>
                                <th>Creada</th>
                                <th>Enviada</th>
                                <th><span class="visually-hidden">Acciones</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var n in FilteredHistory)
                            {
                                <tr>
                                    <td data-label="Tipo"><StatusBadge Status="@n.Type" /></td>
                                    <td data-label="Destinatario">@n.Recipient</td>
                                    <td data-label="Estado"><StatusBadge Status="@n.Status" /></td>
                                    <td data-label="Creada" class="cell-sub cell-nowrap">@n.CreatedAt.ToLocalTime().ToString("dd/MM/yy HH:mm")</td>
                                    <td data-label="Enviada" class="cell-sub cell-nowrap">@(n.SentAt.HasValue ? n.SentAt.Value.ToLocalTime().ToString("dd/MM/yy HH:mm") : "—")</td>
                                    <td data-label="" class="td-actions">
                                        <button type="button" class="icon-btn" aria-label="Ver detalle" title="Ver detalle" @onclick="() => OpenDetail(n)">
                                            <Icon Name="eye" />
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </section>
</div>

@if (_detailNotif != null)
{
    <ModalShell Title="Detalle de notificación" Icon="bell" Size="ModalSize.Small" CloseOnBackdrop="true" OnClose="EventCallback.Factory.Create(this, CloseDetail)">
        <ChildContent>
            <div class="stack">
                <div class="row">
                    <StatusBadge Status="@_detailNotif.Type" />
                    <StatusBadge Status="@_detailNotif.Status" />
                </div>

                <div class="read-block">
                    <p class="read-label">Destinatario</p>
                    <p>@_detailNotif.Recipient</p>
                </div>

                @if (!string.IsNullOrEmpty(_detailNotif.Subject))
                {
                    <div class="read-block">
                        <p class="read-label">Asunto</p>
                        <p>@_detailNotif.Subject</p>
                    </div>
                }

                <div class="read-block">
                    <p class="read-label">Mensaje</p>
                    <p class="read-field">@_detailNotif.Body</p>
                </div>

                <div class="form-row">
                    <div class="read-block">
                        <p class="read-label">Creada</p>
                        <p>@_detailNotif.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</p>
                    </div>
                    <div class="read-block">
                        <p class="read-label">Enviada</p>
                        <p>@(_detailNotif.SentAt.HasValue ? _detailNotif.SentAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") : "—")</p>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_detailNotif.Error))
                {
                    <div class="alert alert-danger" role="alert"><Icon Name="alert" /> @_detailNotif.Error</div>
                }
            </div>
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-secondary" @onclick="CloseDetail">Cerrar</button>
        </Footer>
    </ModalShell>
}

@code {
    private List<NotificationStatusResponse>? _history;
    private bool   _loadingHistory = true;
    private bool   _sending;

    // Modal de detalle
    private NotificationStatusResponse? _detailNotif;

    private void OpenDetail(NotificationStatusResponse n) => _detailNotif = n;
    private void CloseDetail() => _detailNotif = null;

    // Filtros del historial
    private string    _filterType      = "";
    private string    _filterStatus    = "";
    private DateTime? _filterFrom;
    private DateTime? _filterTo;
    private string    _filterRecipient = "";

    private bool HasActiveFilters =>
        !string.IsNullOrEmpty(_filterType)      ||
        !string.IsNullOrEmpty(_filterStatus)    ||
        _filterFrom.HasValue                    ||
        _filterTo.HasValue                      ||
        !string.IsNullOrEmpty(_filterRecipient);

    private IEnumerable<NotificationStatusResponse> FilteredHistory
    {
        get
        {
            if (_history == null) return [];
            var q = _history.AsEnumerable();

            if (!string.IsNullOrEmpty(_filterType))
                q = q.Where(n => n.Type.Equals(_filterType, StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrEmpty(_filterStatus))
                q = q.Where(n => n.Status.Equals(_filterStatus, StringComparison.OrdinalIgnoreCase));

            // Compara solo la fecha (sin hora) contra CreatedAt en hora local
            if (_filterFrom.HasValue)
                q = q.Where(n => n.CreatedAt.ToLocalTime().Date >= _filterFrom.Value.Date);

            if (_filterTo.HasValue)
                q = q.Where(n => n.CreatedAt.ToLocalTime().Date <= _filterTo.Value.Date);

            if (!string.IsNullOrEmpty(_filterRecipient))
                q = q.Where(n => n.Recipient.Contains(_filterRecipient, StringComparison.OrdinalIgnoreCase));

            return q;
        }
    }

    private void ClearFilters()
    {
        _filterType      = "";
        _filterStatus    = "";
        _filterFrom      = null;
        _filterTo        = null;
        _filterRecipient = "";
    }

    // Formulario manual
    private string _notifType   = "whatsapp";
    private string _whatsappTo  = "";   // número completo emitido por PhoneInput
    private string _recipient   = "";
    private string _message     = "";
    private string _subject     = "";
    private string? _sendError;
    private string? _sendSuccess;

    protected override async Task OnInitializedAsync()
    {
        await LoadHistory();
    }

    private async Task LoadHistory()
    {
        _loadingHistory = true;
        try
        {
            // Si es propietario, pasa el teléfono para que el backend filtre sus notificaciones
            var user  = Token.User;
            var phone = (user?.Role?.Equals("Owner", StringComparison.OrdinalIgnoreCase) == true)
                ? user.Phone
                : null;

            _history = await NotificationApi.ListAllAsync(pageSize: 100, phone: phone);
        }
        catch { _history = []; }
        finally { _loadingHistory = false; }
    }

    private async Task SendNotification()
    {
        _sendError = null;
        _sendSuccess = null;

        if (_notifType == "whatsapp" && string.IsNullOrWhiteSpace(_whatsappTo))
        {
            _sendError = "Ingresa el número de teléfono.";
            return;
        }
        if (_notifType == "email" && string.IsNullOrWhiteSpace(_recipient))
        {
            _sendError = "Ingresa el correo destino.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_message))
        {
            _sendError = "Escribe el mensaje.";
            return;
        }

        _sending = true;
        try
        {
            if (_notifType == "whatsapp")
            {
                await NotificationApi.SendWhatsAppAsync(new SendWhatsAppRequest
                {
                    To      = _whatsappTo,
                    Message = _message
                });
            }
            else
            {
                await NotificationApi.SendEmailAsync(new SendEmailRequest
                {
                    To      = _recipient.Trim(),
                    Subject = _subject,
                    Body    = _message
                });
            }
            _sendSuccess = "Notificación enviada (procesando en segundo plano).";
            _whatsappTo = ""; _recipient = ""; _message = ""; _subject = "";
            // Espera a que el background task del backend actualice el estado en BD
            await Task.Delay(2500);
            await LoadHistory();
        }
        catch (Exception ex)
        {
            _sendError = $"Error al enviar: {ex.Message}";
        }
        finally
        {
            _sending = false;
        }
    }
}
