@page "/register"
@inject AuthApiClient AuthApi
@inject TokenProvider Token
@inject NavigationManager Nav

<PageTitle>Crear cuenta — VetSystem</PageTitle>

<div class="auth-wrapper">
    <form class="auth-card auth-card-wide" @onsubmit="DoRegister" novalidate>
        <div class="auth-logo">
            <span class="auth-logo-icon"><Icon Name="paw" Size="28" /></span>
            <h1 class="auth-logo-title">VetSystem</h1>
            <p class="auth-logo-sub">Crear nueva cuenta</p>
        </div>

        @if (_registered)
        {
            <div class="empty-state">
                <span class="empty-state-icon"><Icon Name="check-circle" Size="30" /></span>
                <p class="empty-state-title">¡Cuenta creada con éxito!</p>
                <p class="empty-state-sub">Ya puedes iniciar sesión con tu correo y contraseña.</p>
                <button type="button" class="btn btn-primary btn-block btn-lg" @onclick='() => Nav.NavigateTo("/login")'>
                    Ir al login
                </button>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger" role="alert"><Icon Name="alert" /> @_error</div>
            }

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" for="reg-first-name">Nombre *</label>
                    <input id="reg-first-name" class="form-control @Cls(_request.FirstName)" autocomplete="given-name"
                           @bind="_request.FirstName" placeholder="Nombre" />
                    <FieldError Show="@(_submitted && string.IsNullOrWhiteSpace(_request.FirstName))" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="reg-last-name">Apellido *</label>
                    <input id="reg-last-name" class="form-control @Cls(_request.LastName)" autocomplete="family-name"
                           @bind="_request.LastName" placeholder="Apellido" />
                    <FieldError Show="@(_submitted && string.IsNullOrWhiteSpace(_request.LastName))" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" for="reg-email">Correo electrónico *</label>
                <input id="reg-email" type="email" class="form-control @Cls(_request.Email)" autocomplete="email"
                       @bind="_request.Email" placeholder="correo@ejemplo.com" />
                <FieldError Show="@(_submitted && string.IsNullOrWhiteSpace(_request.Email))" />
            </div>

            <div class="form-group">
                <label class="form-label" for="reg-phone">Teléfono</label>
                <PhoneInput Id="reg-phone" @bind-Value="_request.Phone" Placeholder="3001234567" />
            </div>

            <div class="form-group">
                <label class="form-label" for="reg-password">Contraseña *</label>
                <input id="reg-password" type="password" autocomplete="new-password"
                       class="form-control @(_submitted && !PasswordStrength.IsValid(_request.Password) ? "invalid" : "")"
                       value="@_request.Password"
                       @oninput="e => _request.Password = e.Value?.ToString() ?? string.Empty"
                       placeholder="Crea una contraseña" />
                <PasswordStrength Password="@_request.Password" />
                <FieldError Show="@(_submitted && !PasswordStrength.IsValid(_request.Password))" Message="La contraseña no cumple los requisitos." />
            </div>

            <div class="form-group">
                <label class="form-label" for="reg-password-confirm">Confirmar contraseña *</label>
                <input id="reg-password-confirm" type="password" autocomplete="new-password"
                       class="form-control @(!string.IsNullOrEmpty(_confirm) && _confirm != _request.Password ? "invalid" : "")"
                       value="@_confirm"
                       @oninput="e => _confirm = e.Value?.ToString() ?? string.Empty"
                       placeholder="Repite la contraseña" />
                <PasswordMatchHint Password="@_request.Password" Confirm="@_confirm" />
            </div>

            <button type="submit" class="btn btn-primary btn-block btn-lg" disabled="@_loading">
                @if (_loading) { <span class="spinner spinner-sm" aria-hidden="true"></span> }
                Crear cuenta
            </button>

            <p class="auth-footer">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
        }
    </form>
</div>

@code {
    private RegisterRequest _request = new() { Role = "Owner" };
    private string  _confirm    = "";
    private bool    _submitted;
    private bool    _loading;
    private bool    _registered;
    private string? _error;

    private async Task DoRegister()
    {
        _submitted = true;
        _error     = null;

        if (string.IsNullOrWhiteSpace(_request.FirstName) ||
            string.IsNullOrWhiteSpace(_request.LastName)  ||
            string.IsNullOrWhiteSpace(_request.Email)     ||
            !PasswordStrength.IsValid(_request.Password)  ||
            _confirm != _request.Password)
            return;

        _loading = true;
        try
        {
            await AuthApi.RegisterAsync(_request);
            _registered = true;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            _error = "Ya existe una cuenta con ese correo.";
        }
        catch (Exception ex)
        {
            _error = $"Error: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private string Cls(string? v) => _submitted && string.IsNullOrWhiteSpace(v) ? "invalid" : "";
}
