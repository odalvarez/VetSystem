@page "/owner-portal"
@attribute [Authorize]
@inject NavigationManager Nav

@inject PatientApiClient     PatientApi
@inject AppointmentApiClient AppointmentApi
@inject TokenProvider        Token

<PageTitle>Portal del propietario — VetSystem</PageTitle>

<header class="page-header">
    <div>
        <h1 class="page-title">Mis mascotas</h1>
        <p class="page-subtitle">Portal del propietario</p>
    </div>
</header>

<div class="page-content">

    @if (_loading)
    {
        <LoadingSpinner Message="Cargando…" />
    }
    else
    {
        @* ── Mascotas ── *@
        <section class="card" aria-labelledby="pets-title">
            <div class="card-header">
                <h2 id="pets-title" class="card-title">Mis mascotas</h2>
                <button type="button" class="btn btn-primary btn-sm" @onclick="() => _showNewPatient = true">
                    <Icon Name="plus" Size="16" /> Registrar mascota
                </button>
            </div>

            <div class="card-body">
                @if (_patients == null || !_patients.Any())
                {
                    <div class="empty-state">
                        <span class="empty-state-icon"><Icon Name="paw" Size="28" /></span>
                        <p class="empty-state-title">No tienes mascotas registradas</p>
                        <p class="empty-state-sub">Registra tu primera mascota para acceder a las funciones del portal.</p>
                        <button type="button" class="btn btn-primary" @onclick="() => _showNewPatient = true">
                            Registrar mascota
                        </button>
                    </div>
                }
                else
                {
                    <div class="patients-grid">
                        @foreach (var p in _patients)
                        {
                            <PatientCard Patient="p"
                                         OnSelect="EventCallback.Factory.Create(this, () => OpenDetail(p))" />
                        }
                    </div>
                }
            </div>
        </section>

        @* ── Citas ── *@
        <section class="card" aria-labelledby="appts-title">
            <div class="card-header">
                <h2 id="appts-title" class="card-title">Mis citas</h2>
                <button type="button" class="btn btn-primary btn-sm" @onclick="() => _showNewAppointment = true"
                        disabled="@(!(_patients?.Any() ?? false))">
                    <Icon Name="plus" Size="16" /> Solicitar cita
                </button>
            </div>

            <div class="table-wrapper">
                @if (_appointments == null || !_appointments.Any())
                {
                    <div class="empty-state">
                        <span class="empty-state-icon"><Icon Name="calendar" Size="28" /></span>
                        <p class="empty-state-title">No tienes citas</p>
                        <p class="empty-state-sub">
                            @(_patients?.Any() == true ? "Solicita tu primera cita con el botón de arriba."
                                                       : "Registra una mascota primero para poder solicitar citas.")
                        </p>
                    </div>
                }
                else
                {
                    <table class="vet-table">
                        <thead>
                            <tr>
                                <th>Mascota</th>
                                <th>Fecha</th>
                                <th>Hora</th>
                                <th>Duración</th>
                                <th>Estado</th>
                                <th>Motivo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in _appointments)
                            {
                                <tr>
                                    <td data-label="Mascota"><strong>@a.PatientName</strong></td>
                                    <td data-label="Fecha">@a.ScheduledAt.ToString("dd/MM/yyyy")</td>
                                    <td data-label="Hora">@a.ScheduledAt.ToString("HH:mm")</td>
                                    <td data-label="Duración">@a.DurationMinutes min</td>
                                    <td data-label="Estado"><StatusBadge Status="@a.Status" /></td>
                                    <td data-label="Motivo" class="cell-sub">@(a.Reason ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </section>
    }
</div>

@if (_showNewPatient)
{
    <PatientFormModal OnSaved="EventCallback.Factory.Create(this, OnPatientSaved)"
                      OnClose="EventCallback.Factory.Create(this, () => _showNewPatient = false)" />
}

@if (_showNewAppointment)
{
    <NewAppointmentModal OnSaved="EventCallback.Factory.Create(this, OnAppointmentSaved)"
                         OnClose="EventCallback.Factory.Create(this, () => _showNewAppointment = false)" />
}

@* PatientDetailModal detecta el rol Owner y muestra la ficha de solo lectura *@
@if (_showDetail && _selectedPatient is not null)
{
    <PatientDetailModal
        Patient="_selectedPatient!"
        OnPatientSaved="EventCallback.Factory.Create(this, OnPatientSaved)"
        OnClose="EventCallback.Factory.Create(this, () => { _showDetail = false; _selectedPatient = null; })" />
}

@if (!string.IsNullOrEmpty(_toast))
{
    <div class="toast-snack" role="status"><Icon Name="check-circle" /> @_toast</div>
}

@code {
    private List<PatientResponse>?      _patients;
    private List<AppointmentResponse>?  _appointments;
    private PatientResponse?            _selectedPatient;

    private bool    _loading            = true;
    private bool    _showNewPatient;
    private bool    _showNewAppointment;
    private bool    _showDetail;
    private string? _toast;

    protected override async Task OnInitializedAsync()
    {
        // [Authorize] garantiza autenticación; cada rol tiene su propio panel
        var role = Token.User?.Role ?? "";
        if (role.Equals("Veterinarian", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo("/vet-dashboard", replace: true);
            return;
        }
        if (role.Equals("Admin", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo("/admin", replace: true);
            return;
        }

        await Task.WhenAll(LoadPatients(), LoadAppointments());
        _loading = false;
    }

    private async Task LoadPatients()
    {
        try
        {
            var result = await PatientApi.ListAsync(page: 1, pageSize: 100);
            _patients = result?.Items ?? [];
        }
        catch { _patients = []; }
    }

    private async Task LoadAppointments()
    {
        try
        {
            _appointments = await AppointmentApi.ListAsync() ?? [];
        }
        catch { _appointments = []; }
    }

    private void OpenDetail(PatientResponse p)
    {
        _selectedPatient = p;
        _showDetail      = true;
    }

    private async Task OnPatientSaved()
    {
        await LoadPatients();
        await ShowToast("Mascota registrada correctamente.");
    }

    private async Task OnAppointmentSaved()
    {
        await LoadAppointments();
        await ShowToast("Cita solicitada correctamente.");
    }

    private async Task ShowToast(string msg)
    {
        _toast = msg;
        StateHasChanged();
        await Task.Delay(3000);
        _toast = null;
        StateHasChanged();
    }
}
