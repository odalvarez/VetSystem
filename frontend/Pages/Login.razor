@page "/"
@page "/login"
@inject AuthApiClient AuthApi
@inject TokenProvider Token
@inject NavigationManager Nav

<PageTitle>Iniciar sesión — VetSystem</PageTitle>

<div class="auth-wrapper">
    <form class="auth-card" @onsubmit="DoLogin" novalidate>
        <div class="auth-logo">
            <span class="auth-logo-icon"><Icon Name="paw" Size="28" /></span>
            <h1 class="auth-logo-title">VetSystem</h1>
            <p class="auth-logo-sub">Sistema de gestión veterinaria</p>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger" role="alert"><Icon Name="alert" /> @_error</div>
        }

        <div class="form-group">
            <label class="form-label" for="login-email">Correo electrónico</label>
            <input id="login-email" type="email" autocomplete="username"
                   class="form-control @(_submitted && string.IsNullOrWhiteSpace(_email) ? "invalid" : "")"
                   @bind="_email" @bind:event="oninput" placeholder="correo@ejemplo.com" />
            <FieldError Show="@(_submitted && string.IsNullOrWhiteSpace(_email))" Message="Ingresa tu correo." />
        </div>

        <div class="form-group">
            <label class="form-label" for="login-password">Contraseña</label>
            <input id="login-password" type="password" autocomplete="current-password"
                   class="form-control @(_submitted && string.IsNullOrWhiteSpace(_password) ? "invalid" : "")"
                   @bind="_password" @bind:event="oninput" placeholder="••••••••" />
            <FieldError Show="@(_submitted && string.IsNullOrWhiteSpace(_password))" Message="Ingresa tu contraseña." />
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg" disabled="@_loading">
            @if (_loading) { <span class="spinner spinner-sm" aria-hidden="true"></span> }
            Ingresar
        </button>

        <p class="auth-footer">¿No tienes cuenta? <a href="/register">Regístrate aquí</a></p>
    </form>
</div>

@code {
    private string _email    = "";
    private string _password = "";
    private bool   _submitted;
    private bool   _loading;
    private string? _error;

    protected override void OnInitialized()
    {
        // Si ya hay sesión activa, redirige según el rol sin mostrar login
        if (Token.IsAuthenticated)
            RedirectByRole();
    }

    private async Task DoLogin()
    {
        _submitted = true;
        _error = null;

        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
            return;

        _loading = true;
        try
        {
            // LoginAsync ahora devuelve LoginUserInfo directamente (el token está en la cookie)
            var user = await AuthApi.LoginAsync(new LoginRequest
            {
                Email    = _email.Trim(),
                Password = _password
            });

            Token.SetSession(user);
            // Cede un ciclo de render para que CascadingAuthenticationState
            // propague el nuevo estado antes de que el router evalúe [Authorize]
            await Task.Yield();
            RedirectByRole();
        }
        catch (HttpRequestException ex) when
            (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized ||
             ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            // 401 = contraseña incorrecta, 404 = usuario no existe — mismo mensaje por seguridad
            _error = "Correo o contraseña incorrectos.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
        {
            _error = "Demasiados intentos. Espera unos minutos e inténtalo de nuevo.";
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar al servidor. Verifica tu conexión e intenta de nuevo.";
        }
        catch
        {
            _error = "Ocurrió un error inesperado. Intenta de nuevo.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void RedirectByRole()
    {
        var role = Token.User?.Role ?? "";
        var dest = role.ToLower() switch
        {
            "veterinarian" => "/vet-dashboard",
            "admin"        => "/admin",
            _              => "/owner-portal"
        };
        Nav.NavigateTo(dest, replace: true);
    }
}
