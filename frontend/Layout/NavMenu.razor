@inject TokenProvider Token
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject AuthApiClient AuthApi
@implements IDisposable

@* Barra superior: solo visible en pantallas de 1024 px o menos (ver .topbar en app.css) *@
<header class="topbar">
    <a class="topbar-brand" href="@_homeUrl">
        <span class="sidebar-logo"><Icon Name="paw" Size="20" /></span>
        VetSystem
    </a>
    <button type="button" class="icon-btn lg" aria-label="@(_navOpen ? "Cerrar menú" : "Abrir menú")"
            aria-expanded="@(_navOpen ? "true" : "false")" aria-controls="app-sidebar" @onclick="ToggleNav">
        <Icon Name="@(_navOpen ? "x" : "menu")" Size="20" />
    </button>
</header>

@if (_navOpen)
{
    <div class="sidebar-overlay" @onclick="ToggleNav"></div>
}

<aside id="app-sidebar" class="sidebar @(_navOpen ? "open" : "")">
    <a class="sidebar-brand-link" href="@_homeUrl">
        <span class="sidebar-logo"><Icon Name="paw" Size="22" /></span>
        <span class="sidebar-brand-text">
            <span class="sidebar-brand-name">VetSystem</span>
            <span class="sidebar-brand-sub">Gestión veterinaria</span>
        </span>
    </a>

    <nav class="sidebar-nav" aria-label="Navegación principal">
        <div class="nav-section-label">@_roleLabel</div>
        @foreach (var item in _items)
        {
            <NavLink class="nav-item" href="@item.Href" Match="NavLinkMatch.All" ActiveClass="active">
                <Icon Name="@item.Icon" /> @item.Label
            </NavLink>
        }
    </nav>

    <div class="sidebar-footer">
        <div class="sidebar-user">
            <div class="sidebar-avatar" aria-hidden="true">@_initials</div>
            <div class="sidebar-user-info">
                <div class="sidebar-user-name">@Token.User?.FullName</div>
                <div class="sidebar-user-role">@_roleLabel</div>
            </div>
        </div>
        <button type="button" class="btn btn-ghost btn-sm btn-block" @onclick="Logout">
            <Icon Name="log-out" Size="16" /> Cerrar sesión
        </button>
    </div>
</aside>

@code {
    private sealed record NavItem(string Href, string Icon, string Label);

    private NavItem[] _items     = [];
    private string    _initials  = "?";
    private string    _homeUrl   = "/";
    private string    _roleLabel = "";
    private bool      _navOpen;

    protected override async Task OnInitializedAsync()
    {
        var state   = await AuthState.GetAuthenticationStateAsync();
        var isAdmin = state.User.IsInRole("Admin");
        var isVet   = state.User.IsInRole("Veterinarian");

        _homeUrl   = isAdmin ? "/admin" : isVet ? "/vet-dashboard" : "/owner-portal";
        _roleLabel = isAdmin ? "Administrador" : isVet ? "Veterinario" : "Propietario";
        _items =
        [
            isAdmin ? new(_homeUrl, "shield", "Panel de administración")
            : isVet ? new(_homeUrl, "layout", "Panel de control")
            :         new(_homeUrl, "paw",    "Mis mascotas"),
            new("/notifications", "bell", "Notificaciones")
        ];

        var parts = (Token.User?.FullName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        _initials = parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1],
            _ => $"{parts[0][0]}{parts[1][0]}"
        };

        Token.OnChange      += StateHasChanged;
        // En móvil el menú se cierra solo al navegar
        Nav.LocationChanged += OnLocationChanged;
    }

    private void ToggleNav() => _navOpen = !_navOpen;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _navOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private async Task Logout()
    {
        await AuthApi.LogoutAsync();
        Token.ClearSession();
        Nav.NavigateTo("/login");
    }

    public void Dispose()
    {
        Token.OnChange      -= StateHasChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
