# Valores exclusivos del stack E2E aislado (docker compose -p vetsystem-e2e).
# No son secretos: la base de datos y los contenedores se destruyen al terminar cada corrida.
# Ningún valor lleva "$" porque docker compose lo interpretaría como variable.
SA_PASSWORD=E2e_SqlPassw0rd!
JWT_SECRET=e2e-jwt-secret-solo-para-pruebas-0123456789abcdef
INTERNAL_KEY=e2e-internal-key-0123456789
ADMIN_SEED_EMAIL=admin.e2e@vetsystem.test
ADMIN_SEED_PASSWORD=AdminE2e#2026
EVOLUTION_API_KEY=e2e-evolution-key
POSTGRES_EVOLUTION_PASSWORD=e2e-postgres-unused
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@vetsystem.test
