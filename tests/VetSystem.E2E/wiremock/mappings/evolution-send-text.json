{
  "mappings": [
    {
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/message/sendText/vetsystem",
        "bodyPatterns": [ { "matchesJsonPath": "$[?(@.number =~ /.*3009999999$/)]" } ]
      },
      "response": {
        "status": 500,
        "jsonBody": { "error": "Número reservado por las pruebas E2E para simular un fallo de envío" }
      }
    },
    {
      "priority": 5,
      "request": {
        "method": "POST",
        "urlPath": "/message/sendText/vetsystem",
        "headers": { "apikey": { "equalTo": "e2e-evolution-key" } }
      },
      "response": {
        "status": 201,
        "jsonBody": { "key": { "id": "E2E-MESSAGE" }, "status": "PENDING" }
      }
    }
  ]
}
